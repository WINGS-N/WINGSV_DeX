{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "vite",
    "build:dev": "vite build --minify false --mode development",
    "build": "vite build --mode production",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{js,ts,vue,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,vue,css,html}\""
  },
  "dependencies": {
    "@lucide/vue": "^1.66.0",
    "@wailsio/runtime": "^3.1.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  }
}
